{
  "name": "me",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NODE_OPTIONS=--disable-warning=ExperimentalWarning next dev -H 127.0.0.1 -p 3737",
    "build": "next build",
    "start": "NODE_OPTIONS=--disable-warning=ExperimentalWarning next start -H 127.0.0.1 -p 3737",
    "build:server": "node scripts/build-server.mjs",
    "app": "npm run build:server && electron .",
    "app:dev": "electron .",
    "dist": "npm run build:server && electron-builder --mac dir",
    "install-app": "npm run dist && rm -rf /Applications/Me.app && cp -R dist/mac-arm64/Me.app /Applications/ && echo Installed /Applications/Me.app"
  },
  "type": "module",
  "devDependencies": {
    "chrono-node": "2.10.3",
    "next": "15.5.29",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "electron": "37.10.3",
    "electron-builder": "26.18.0"
  },
  "main": "electron/main.cjs",
  "productName": "Me",
  "description": "Personal dashboard: tasks, calendar and email",
  "author": "wastella",
  "build": {
    "appId": "com.wastella.me",
    "productName": "Me",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "target": [
        "dir"
      ],
      "darkModeSupport": true,
      "identity": null
    },
    "asar": true,
    "npmRebuild": false,
    "afterPack": "scripts/after-pack.cjs"
  }
}
